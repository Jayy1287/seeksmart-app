# Runtime connection through Supabase pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection for Prisma migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js / Google OAuth and passwordless email sign-in.
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
RESEND_API_KEY="replace-with-resend-api-key"
AUTH_EMAIL_FROM="SeekSmart <hello@yourdomain.com>"
AUTH_EMAIL_REPLY_TO="support@yourdomain.com"
ADMIN_EMAILS="you@example.com"

# Minimal admin auth for the review workspace.
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Optional product analytics through PostHog.
NEXT_PUBLIC_POSTHOG_KEY=""
# Set NEXT_PUBLIC_POSTHOG_PROXY=true to route events through the /ingest rewrite instead of the host below.
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
NEXT_PUBLIC_POSTHOG_UI_HOST="https://eu.posthog.com"

SHOW_TOOL_LIKE_COUNTS=false

# Optional: connection used only during `next build` (session pooler, small pool).
BUILD_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?connection_limit=4&pool_timeout=60"

# Where tool logos and screenshots are served from. Leave empty to use public/logos and
# public/screenshots on disk (not committed). In production point it at an object store,
# e.g. https://PROJECT_REF.supabase.co/storage/v1/object/public/tool-media
NEXT_PUBLIC_TOOL_MEDIA_BASE_URL=""

# Hosting: skip database-backed prerendering at build time (pages render on first request).
SKIP_BUILD_PRERENDER="1"
NEXT_PUBLIC_POSTHOG_PROXY="false"

# Only for scripts/upload-tool-media.mjs (never needed by the app itself).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
